# Copy to .env and fill in real values. Never commit .env.
# All variables are optional; defaults are shown. See src/config.ts.

# Network: must be a loopback address (127.0.0.1, localhost or ::1); the API has no authentication
HOST=127.0.0.1
PORT=3000

# Matches docker-compose.yml
DATABASE_URL=postgres://loom:loompassword@localhost:5432/loomdb

# Local AI (Ollama). EMBED_MODEL must output 1024 dimensions (DB column is vector(1024)).
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=bge-m3

# Optional cloud LLM. Leave GEMINI_API_KEY empty to stay 100% local (Ollama qwen2.5:7b-instruct).
# NOTE: with a key, article text and project notes are sent to Google's API.
GEMINI_API_KEY=
# LLM providers tried in order; those without an API key are skipped, ollama needs none.
# Default: DeepSeek first, then Gemini, then local Qwen (see evals/REPORT.md for the comparison).
LLM_PROVIDERS=deepseek,gemini,ollama
# Optional DeepSeek key (api.deepseek.com). With it listed in LLM_PROVIDERS, article text and
# project notes are sent to DeepSeek. Thinking mode is always requested OFF unless a call opts in.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Gemini model name (defaults to gemini-3.1-flash-lite). GEMINI_MODEL, if set, overrides it.
CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL=

# Languages (es | en). LANGUAGE is a preset: the interface default, the language of suggestions
# and answers, and the language of your notes. Override either of the last two below, or change
# them in Configuración / Settings. Summaries are written in the notes language, because they are
# compared with your notes.
LANGUAGE=en
# OUTPUT_LANGUAGE=en
# NOTES_LANGUAGE=en

# Obsidian vault root (contains Projects/ or Proyectos/). Can also be set from the UI.
# If unset, `pnpm start` / `pnpm dev` use the demo vault in the notes language:
# ./demo_vault (Spanish) or ./demo_vault_en (English).
# VAULT_PATH=C:/path/to/ObsidianVault

# Server log level: fatal|error|warn|info|debug|trace|silent. Logs never contain note or
# article text, prompts, model output or URLs.
LOG_LEVEL=info
# pretty (one readable line per record) or json (raw lines; default when NODE_ENV=production)
# LOG_FORMAT=pretty

# Eval harness: abort a run before the estimated LLM spend exceeds this many USD (pnpm eval)
EVAL_MAX_USD=0.50
