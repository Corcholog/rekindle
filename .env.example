# Copy to .env and fill in real values. Never commit .env.
# All variables are optional; defaults are shown. See src/config.ts.

# Network: must be a loopback address (127.0.0.1, localhost or ::1); the API has no authentication
HOST=127.0.0.1
PORT=3000

# Matches docker-compose.yml
DATABASE_URL=postgres://loom:loompassword@localhost:5432/loomdb

# Local AI (Ollama). EMBED_MODEL must output 1024 dimensions (DB column is vector(1024)).
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=bge-m3

# Optional cloud LLM. Leave GEMINI_API_KEY empty to stay 100% local (Ollama qwen2.5:7b-instruct).
# NOTE: with a key, article text and project notes are sent to Google's API.
GEMINI_API_KEY=
# LLM providers tried in order; those without an API key are skipped, ollama needs none.
# Default keeps today's behavior. Set deepseek,gemini,ollama to use DeepSeek first.
LLM_PROVIDERS=gemini,ollama
# Optional DeepSeek key (api.deepseek.com). With it listed in LLM_PROVIDERS, article text and
# project notes are sent to DeepSeek. Thinking mode is always requested OFF unless a call opts in.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Gemini model name (defaults to gemini-3.1-flash-lite). GEMINI_MODEL, if set, overrides it.
CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL=

# Obsidian vault root (contains Projects/ or Proyectos/). Can also be set from the UI.
# If unset, `pnpm start` / `pnpm dev` fall back to ./demo_vault.
# VAULT_PATH=C:/path/to/ObsidianVault

# Fastify log level: fatal|error|warn|info|debug|trace
LOG_LEVEL=warn
