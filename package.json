{
  "name": "rekindle",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.include=src/** --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.reportOnFailure",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:reset": "tsx src/db/reset.ts",
    "start": "tsx scripts/run_server.ts",
    "dev": "tsx watch scripts/run_server.ts",
    "typecheck": "tsc --noEmit",
    "preflight": "tsx src/doctor/cli.ts",
    "eval": "tsx evals/runner/cli.ts",
    "eval:snapshot": "tsx evals/runner/cli.ts snapshot",
    "eval:fetch": "tsx evals/runner/cli.ts fetch",
    "eval:label": "tsx evals/runner/cli.ts label",
    "eval:check": "tsx evals/runner/cli.ts check",
    "eval:report": "tsx evals/runner/cli.ts report",
    "eval:review": "tsx evals/runner/cli.ts review",
    "eval:sweep": "tsx evals/runner/cli.ts sweep",
    "telemetry:report": "tsx src/observability/cli.ts report",
    "telemetry:trace": "tsx src/observability/cli.ts trace",
    "telemetry:prune": "tsx src/observability/cli.ts prune",
    "usertest:stats": "tsx src/usertest/cli.ts"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "7.0.0",
    "@typescript-eslint/parser": "7.0.0",
    "@vitest/coverage-v8": "1.6.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^8.57.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@google/genai": "^2.28.0",
    "@langchain/core": "^1.2.17",
    "@langchain/ollama": "^1.3.0",
    "@mozilla/readability": "^0.6.0",
    "chokidar": "^5.0.0",
    "dotenv": "^18.0.6",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "jsdom": "^30.1.2",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.1",
    "pino": "10.4.0",
    "undici": "^7.30.1",
    "youtube-transcript": "^1.3.1",
    "zod": "^4.6.5"
  }
}
